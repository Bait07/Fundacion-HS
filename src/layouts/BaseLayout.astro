---
import SEOHead from '@/components/SEOHead.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFAB from '@/components/WhatsAppFAB.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image, type } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead {title} {description} {image} {type} />

    <!-- Google Material Symbols (icon font) — agregado en Task 4 para la
         barra de accesos rápidos; Task 12 reutiliza este mismo <link> sin
         duplicarlo. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
    />

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <Navbar />
    <main id="main-content" style="padding-top: var(--nav-height)">
      <slot />
    </main>
    <Footer />
    <WhatsAppFAB />

    <script>
      const NO_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const IS_MOBILE = window.matchMedia('(max-width: 1023px)').matches;
      if (!NO_MOTION && !IS_MOBILE) {
        const heroImg = document.querySelector<HTMLElement>('.hero__bg-img');
        const heroEl  = document.querySelector<HTMLElement>('.hero');
        if (heroImg && heroEl) {
          let rafPending = false;
          window.addEventListener('scroll', () => {
            if (rafPending) return;
            rafPending = true;
            requestAnimationFrame(() => {
              const y = window.scrollY;
              if (y < heroEl.offsetHeight * 1.5) {
                heroImg.style.transform = `translateY(${y * 0.28}px)`;
              }
              rafPending = false;
            });
          }, { passive: true });
        }
      }

      // Scroll reveal — IntersectionObserver
      // Observa `.reveal` (patrón general del sitio, transition-based) y
      // `[data-anim]` (Task 3 + Task 5: sistema de 5 keyframes —
      // fadeInDown/fadeInUp/fadeInLeft/slideInUp/zoomIn — keyed por el
      // VALOR del atributo, ver src/styles/global.css). Un solo observer
      // para toda la app: ambos mecanismos solo necesitan la clase
      // `.visible` + unobserve, el resto (qué anima y cómo) vive en CSS.
      // threshold subido de 0.12 a 0.2 (Task 5, alineado al spec de este
      // bloque) — aplica igual a `.reveal` y a `[data-anim]`.
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.reveal, [data-anim]').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
