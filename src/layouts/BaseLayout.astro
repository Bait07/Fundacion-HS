---
import SEOHead from '@/components/SEOHead.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFAB from '@/components/WhatsAppFAB.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image, type } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead {title} {description} {image} {type} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <Navbar />
    <main id="main-content" style="padding-top: 68px">
      <slot />
    </main>
    <Footer />
    <WhatsAppFAB />

    <script>
      const NO_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const IS_MOBILE = window.matchMedia('(max-width: 1023px)').matches;
      if (!NO_MOTION && !IS_MOBILE) {
        const heroImg = document.querySelector<HTMLElement>('.hero__bg-img');
        const heroEl  = document.querySelector<HTMLElement>('.hero');
        if (heroImg && heroEl) {
          let rafPending = false;
          window.addEventListener('scroll', () => {
            if (rafPending) return;
            rafPending = true;
            requestAnimationFrame(() => {
              const y = window.scrollY;
              if (y < heroEl.offsetHeight * 1.5) {
                heroImg.style.transform = `translateY(${y * 0.28}px)`;
              }
              rafPending = false;
            });
          }, { passive: true });
        }
      }

      // Scroll reveal — IntersectionObserver
      // Observa `.reveal` (patrón general del sitio) y `[data-anim]`
      // (Task 3: entrada mínima del hero vía fadeInDown; Task 5 construirá
      // sobre este mismo atributo el sistema completo de 5 keyframes —
      // fadeInDown/fadeInUp/fadeInLeft/slideInUp/zoomIn — y debe seguir
      // usando este único observer, no crear uno paralelo).
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.reveal, [data-anim]').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
