---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { seo } from './home/_data/index';
import Hero from './home/_sections/Hero.astro';
import QuickAccess from './home/_sections/QuickAccess.astro';
import About from './home/_sections/About.astro';
import Stats from './home/_sections/Stats.astro';
import Programs from './home/_sections/Programs.astro';
import Testimonials from './home/_sections/Testimonials.astro';
import PadrinoCta from './home/_sections/PadrinoCta.astro';
import ContactQuick from './home/_sections/ContactQuick.astro';
import Aliados from './home/_sections/Aliados.astro';
import './home/styles/index.css';
---

<BaseLayout title={seo.title} description={seo.description}>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "NGO",
    "name": "Fundación Horizontes de Sabiduría",
    "alternateName": "FHS",
    "description": "Fundación sin ánimo de lucro en Bogotá que acompaña a niños, jóvenes y adultos con discapacidad cognitiva e intelectual y a sus familias mediante programas de inclusión educativa y social, atención interdisciplinaria y el Plan Padrino.",
    "url": "https://www.fundhorizontesdesabiduria.org",
    "logo": "https://www.fundhorizontesdesabiduria.org/logo.png",
    "image": "https://www.fundhorizontesdesabiduria.org/og-image.jpg",
    "taxID": "902.040.005-1",
    "nonprofitStatus": "Nonprofit",
    "email": "contacto@fundhorizontesdesabiduria.org",
    "telephone": "+57 317 375 9920",
    "areaServed": { "@type": "City", "name": "Bogotá" },
    "knowsAbout": ["Discapacidad cognitiva", "Discapacidad intelectual", "Inclusión educativa", "Neurodivergencia", "Educación especial"],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bogotá",
      "addressRegion": "Bogotá D.C.",
      "addressCountry": "CO"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "telephone": "+57 317 375 9920",
      "email": "contacto@fundhorizontesdesabiduria.org",
      "availableLanguage": "Spanish"
    }
  }
  </script>

  <Hero />
  <QuickAccess />
  <About />
  <PadrinoCta />
  <Testimonials />
  <Stats />
  <Programs />
  <Aliados />
  <ContactQuick />
</BaseLayout>

<script>
  import './home/_js/index';
</script>
