---
import { enfoque } from '../data/index';

const icons: string[] = [
  // Book Open — Inclusión educativa
  `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
  // Activity — Atención integral
  `<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>`,
  // Scale — Enfoque diferencial
  `<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/><path d="M7 21h10"/><line x1="12" x2="12" y1="3" y2="21"/><path d="M3 7h2c2 0 4-1 7-1s5 1 7 1h2"/>`,
  // Home — Participación familiar
  `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  // Compass — Desarrollo de autonomía
  `<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>`,
  // Heart — Dignidad humana
  `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>`,
  // Users — Fortalecimiento comunitario
  `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
];
---
<section class="section enfoque-section" aria-labelledby="enfoque-heading">
  <div class="container enfoque-inner">
    <div class="enfoque-header reveal">
      <h2 id="enfoque-heading">Nuestro enfoque</h2>
      <p>Principios que guían cada programa, taller y acompañamiento.</p>
    </div>

    <ol class="principios-list" aria-label="Principios de la fundación">
      {enfoque.map((item, i) => (
        <li class={`principio-row reveal reveal-delay-${(i % 3) + 1}`}>
          <svg
            class="principio-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons[i]}
          />
          <span class="principio-text">{item}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
