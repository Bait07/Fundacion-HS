---
import { razones } from '../data/index';

const iconPaths: string[] = [
  // Heart — Atención cálida
  `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>`,
  // User — Procesos personalizados
  `<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>`,
  // Users — Equipo interdisciplinario
  `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  // Shield — Espacios seguros
  `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  // Home — Acompañamiento familiar
  `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  // Layers — Programas por etapa
  `<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>`,
];
---
<section class="section razones-section" aria-labelledby="razones-heading">
  <div class="container razones-inner">
    <div class="razones-header reveal">
      <h2 id="razones-heading">Por qué elegirnos</h2>
      <p>Lo que nos distingue como acompañantes de familias en Bogotá.</p>
    </div>

    <ol class="razones-list" aria-label="Razones para elegirnos">
      {razones.map((razon, i) => (
        <li class={`razon-row reveal reveal-delay-${(i % 3) + 1}`}>
          <span class="razon-row__badge" aria-hidden="true">#{i + 1}</span>
          <svg
            class="razon-row__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={iconPaths[i]}
          />
          <div class="razon-row__copy">
            <h3 class="razon-row__title">{razon.title}</h3>
            <p class="razon-row__desc">{razon.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
