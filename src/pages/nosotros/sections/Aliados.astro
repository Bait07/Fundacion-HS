---
import { aliados, ALIADOS_MINIMO, huecos } from '@/data/organizacion';
import { withBase } from '@/utils/url';
---
<section class="section aliados-section" id="aliados" aria-labelledby="aliados-heading">
  <div class="container aliados-inner">
    <h2 id="aliados-heading" class="reveal">Nuestros aliados</h2>
    {aliados.length === 0 && (
      <p class="aliados-note reveal reveal-delay-1">
        Próximamente presentaremos a los aliados estratégicos de la FHS.
      </p>
    )}
    <div class="aliados-carousel reveal reveal-delay-2" tabindex="0" role="group" aria-label="Aliados de la fundación">
      <ul class="aliados-track" role="list">
        {aliados.map((a) => (
          <li class="aliado-badge aliado-badge--logo">
            {a.url
              ? <a href={a.url} target="_blank" rel="noopener noreferrer"><img src={withBase(a.logoNosotros ?? a.logo)} alt={a.nombre} loading="lazy" /></a>
              : <img src={withBase(a.logoNosotros ?? a.logo)} alt={a.nombre} loading="lazy" />}
          </li>
        ))}
        {huecos(aliados.length, ALIADOS_MINIMO).map(() => (
          <li class="aliado-badge" aria-hidden="true">
            <span class="material-symbols-outlined aliado-badge__icon">handshake</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="section-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 64" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path class="section-wave-path section-wave-path--ink" d="M0,40 C240,64 480,16 720,40 C960,64 1200,20 1440,40 L1440,64 L0,64 Z"/>
    </svg>
  </div>
</section>
