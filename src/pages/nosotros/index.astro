---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { seo } from './_data/index';
import PageHeader from './_sections/PageHeader.astro';
import Historia from './_sections/Historia.astro';
import Impacto from './_sections/Impacto.astro';
import MisionVision from './_sections/MisionVision.astro';
import Enfoque from './_sections/Enfoque.astro';
import PorQueElegirnos from './_sections/PorQueElegirnos.astro';
import Equipo from './_sections/Equipo.astro';
import Aliados from './_sections/Aliados.astro';
import ContactCta from './_sections/ContactCta.astro';
import './styles/index.css';
---

<BaseLayout title={seo.title} description={seo.description}>
  <PageHeader />
  <Historia />
  <Impacto />
  <MisionVision />
  <Enfoque />
  <Equipo />
  <PorQueElegirnos />
  <Aliados />
  <ContactCta />
</BaseLayout>
