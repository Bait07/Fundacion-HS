---
---
<section class="section contact-quick" aria-labelledby="contact-heading">
  <div class="container contact-quick__inner">
    <h2 id="contact-heading" class="reveal">¿Tienes preguntas? Estamos aquí.</h2>
    <p class="contact-quick__text reveal reveal-delay-1">
      Ya sea que busques información sobre nuestros programas, quieras apoyar la fundación o simplemente conocernos, con mucho gusto te atendemos.
    </p>
    <div class="contact-quick__actions reveal reveal-delay-2">
      <a
        href="https://wa.me/XXXXXXXXXX?text=Hola,%20me%20gustar%C3%ADa%20conocer%20m%C3%A1s%20sobre%20la%20Fundaci%C3%B3n%20Horizontes%20de%20Sabidur%C3%ADa."
        class="btn btn-primary contact-quick__wa"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img src={`${import.meta.env.BASE_URL}whatsapp.png`} alt="" width="18" height="18" aria-hidden="true" />
        Escríbenos por WhatsApp
      </a>
      <a href={`${import.meta.env.BASE_URL}contacto`} class="btn btn-outline">Enviar un mensaje</a>
    </div>
  </div>

  <div class="section-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 64" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path class="section-wave-path section-wave-path--ink" d="M0,40 C240,64 480,16 720,40 C960,64 1200,20 1440,40 L1440,64 L0,64 Z"/>
    </svg>
  </div>
</section>
