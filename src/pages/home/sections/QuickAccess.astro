---
import { withBase } from '@/utils/url';
// Task 4: barra de accesos rápidos flotante. Se monta sobre el borde
// inferior del hero (margin-top negativo en `.quick-access__bar`, ver
// home/styles/index.css). Enlaza únicamente a rutas reales del sitio —
// no existe una ruta `/voluntariado`, así que "Sé voluntario" apunta a
// `/contacto` (el formulario de contacto no soporta hoy preseleccionar
// el motivo vía query param; agregar esa preselección es trabajo del
// formulario, fuera del alcance de esta tarea).
const quickLinks = [
  { href: '/donaciones', label: 'Donar', desc: 'Apoya nuestros programas', icon: 'volunteer_activism', main: true },
  { href: '/contacto', label: 'Sé voluntario', desc: 'Suma tu tiempo y talento', icon: 'diversity_3' },
  { href: '/programas', label: 'Programas', desc: 'Acompañamos cada etapa', icon: 'school' },
  { href: '/contacto', label: 'Contacto', desc: 'Escríbenos, te respondemos', icon: 'mail' },
];
---
<section class="quick-access" aria-label="Accesos rápidos">
  <div class="container">
    <nav class="quick-access__bar" aria-label="Accesos rápidos">
      <ul class="quick-access__list">
        {quickLinks.map((link) => (
          <li class="quick-access__item">
            <a href={withBase(link.href)} class:list={['quick-access__link', { 'quick-access__link--main': link.main }]}>
              <span class="quick-access__icon-wrap" aria-hidden="true">
                <span class="material-symbols-outlined quick-access__icon">{link.icon}</span>
              </span>
              <span class="quick-access__text">
                <span class="quick-access__label">{link.label}</span>
                <span class="quick-access__desc">{link.desc}</span>
              </span>
              <span class="material-symbols-outlined quick-access__arrow" aria-hidden="true">arrow_forward</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>
