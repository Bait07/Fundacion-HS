---
---
<section class="hero" aria-label="Bienvenida">
  <div class="hero__bg" aria-hidden="true">
    <img
      src="/images/hero-banner.jpg"
      alt=""
      class="hero__bg-img"
      width="1024"
      height="665"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__overlay"></div>
  </div>

  <!-- Decorative rings (desktop only) -->
  <div class="hero__deco" aria-hidden="true">
    <div class="hero__deco-ring"></div>
    <div class="hero__deco-dot"></div>
  </div>

  <div class="container hero__content">
    <div class="hero__text" data-anim="fadeInDown">
      <h1 class="hero__title">
        Fundación Horizontes de Sabiduría. 
      </h1>
      <p class="hero__subtitle">
        Acompañamos a niños, jóvenes y adultos con discapacidad cognitiva en Bogotá a descubrir sus horizontes.
      </p>
      <div class="hero__actions">
        <a href="/programas" class="btn btn-primary">Conoce nuestros programas</a>
        <a href="/donaciones" class="btn btn-outline">Quiero donar</a>
      </div>
    </div>
  </div>

  <!-- Wave transition to next section -->
  <div class="section-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 64" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path class="section-wave-path" d="M0,40 C240,64 480,16 720,40 C960,64 1200,20 1440,40 L1440,64 L0,64 Z"/>
    </svg>
  </div>
</section>
