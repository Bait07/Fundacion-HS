---
import { stats } from '../data/index';
---
<section class="section stats" aria-labelledby="stats-heading">
  <dotlottie-wc class="stats__plane" src="/lottie-airplane.lottie" autoplay loop aria-hidden="true"></dotlottie-wc>
  <div class="container">
    <h2 id="stats-heading" class="stats__heading reveal">Nuestro alcance</h2>
    <div class="stats__strip">
      {stats.map((stat, i) => (
        <div class={`stats__item anim-delay-${i + 1}`} data-anim="slideInUp">
          <span class="stats__value">{stat.value}</span>
          <span class="stats__label">{stat.label}</span>
        </div>
      ))}
    </div>
    <p class="stats__note reveal reveal-delay-4">
      La fundación está en sus primeros pasos — estos números crecerán con tu apoyo.
    </p>
  </div>

  <div class="section-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 64" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path class="section-wave-path" d="M0,40 C240,64 480,16 720,40 C960,64 1200,20 1440,40 L1440,64 L0,64 Z"/>
    </svg>
  </div>
</section>

<script type="module" src="https://cdn.jsdelivr.net/npm/@lottiefiles/dotlottie-wc@0.9.27/dist/dotlottie-wc.js"></script>
