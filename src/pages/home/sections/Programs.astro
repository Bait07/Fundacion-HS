---
import { programs } from '../data/index';
import { withBase } from '@/utils/url';
---
<section class="section programs" aria-labelledby="programs-heading">
  <div class="container programs__inner">
    <div class="programs__header reveal">
      <h2 id="programs-heading">Un programa para cada etapa</h2>
      <p class="programs__subtitle">
        Cuatro programas para cada etapa de la vida, con atención interdisciplinaria.
      </p>
    </div>

    <div class="programs__body">
      <ul class="prog-cards" role="list">
        {programs.map((prog, i) => (
          <li class={`prog-card anim-delay-${i + 1}`} data-anim="fadeInLeft">
            <a href={withBase(prog.href)} class="prog-card__link" style={`--card-accent: ${prog.color}`}>
              <h3 class="prog-card__name">{prog.title}</h3>
              <p class="prog-card__desc">{prog.desc}</p>
              <span class="prog-card__more">
                Conoce más
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="programs__cta reveal">
      <a href={`${import.meta.env.BASE_URL}programas`} class="btn btn-primary">Ver todos los programas</a>
    </div>
  </div>
</section>
