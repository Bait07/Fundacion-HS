---
import { programs } from '../data/index';
import { withBase } from '@/utils/url';
---
<section class="section programs" aria-labelledby="programs-heading">
  <div class="container programs__inner">
    <div class="programs__header reveal">
      <h2 id="programs-heading">Un programa para cada etapa</h2>
      <p class="programs__subtitle">
        Cuatro programas para cada etapa de la vida, con atención interdisciplinaria.
      </p>
    </div>

    <div class="programs__body">
      <ul class="prog-index" role="list">
        {programs.map((prog, i) => (
          <li class={`prog-index__item anim-delay-${i + 1}`} data-anim="fadeInLeft">
            <a href={withBase(prog.href)} class:list={['prog-index__link', { 'prog-index__link--destacado': prog.destacado }]} aria-label={`${prog.title}: conoce más`}>
              <span class="prog-index__name">{prog.short}</span>
              <span class="prog-index__desc">{prog.desc}</span>
              <dotlottie-wc class="prog-index__lottie" src={withBase(prog.lottie)} autoplay loop aria-hidden="true"></dotlottie-wc>
              <span class="prog-index__arrow" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="programs__cta reveal">
      <a href={`${import.meta.env.BASE_URL}programas`} class="btn btn-primary">Ver todos los programas</a>
    </div>
  </div>
</section>

<script type="module" src="https://cdn.jsdelivr.net/npm/@lottiefiles/dotlottie-wc@0.9.27/dist/dotlottie-wc.js"></script>
