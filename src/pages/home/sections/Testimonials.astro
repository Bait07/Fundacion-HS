---
import { testimonials } from '../data/index';
---
<section class="section testimonials" aria-labelledby="testimonials-heading">
  <div class="container testimonials__inner">
    <div class="testimonials__header reveal">
      <h2 id="testimonials-heading">Horizontes que hemos construido juntos</h2>
      <p class="testimonials__note">Las familias que acompañamos cuentan su experiencia.</p>
    </div>

    <div class="testimonials__grid">
      {testimonials.map((t, i) => (
        <figure class:list={['testimonial reveal', `reveal-delay-${i + 1}`, { 'testimonial--vertical': t.vertical }]}>
          <!-- #t=0.5: muestra un fotograma como portada sin generar imagen aparte -->
          <video class="testimonial__video" src={`${import.meta.env.BASE_URL}${t.video}#t=0.5`} controls preload="metadata" playsinline aria-label={`Testimonio: ${t.role}`}></video>
        </figure>
      ))}
    </div>
  </div>
</section>
