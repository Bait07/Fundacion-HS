---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seo = {
  title: 'Blog | Educación Inclusiva y Discapacidad Cognitiva — Fundación Horizontes de Sabiduría',
  description: 'Artículos sobre inclusión educativa, discapacidad cognitiva, desarrollo humano e historias inspiradoras de la Fundación Horizontes de Sabiduría en Bogotá.',
};

const postModules = import.meta.glob('./posts/*.md', { eager: true }) as Record<string, { frontmatter: Record<string, string>; url: string }>;

const sortedPosts = Object.entries(postModules)
  .map(([path, p]) => ({
    title: p.frontmatter.title,
    desc: p.frontmatter.description,
    date: p.frontmatter.date,
    category: p.frontmatter.category,
    image: p.frontmatter.image,
    slug: p.url ?? path.replace('./posts', '/blog/posts').replace('.md', ''),
    readTime: p.frontmatter.readTime,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const categories = ['Educación consciente', 'Desarrollo humano', 'Comunidad', 'Historias inspiradoras'];
---

<BaseLayout title={seo.title} description={seo.description}>
  <section class="page-header" aria-labelledby="page-title">
    <div class="container">
      <h1 id="page-title" class="reveal">Blog</h1>
      <p class="page-header__desc reveal reveal-delay-1">
        Artículos sobre inclusión educativa, discapacidad cognitiva, desarrollo humano e historias que inspiran.
      </p>
      <!-- Categories -->
      <div class="blog-cats reveal reveal-delay-2">
        {categories.map(cat => (
          <span class="blog-cat">{cat}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-label="Artículos del blog">
    <div class="container blog-grid">
      {sortedPosts.map((post, i) => (
        <article class={`blog-card reveal reveal-delay-${(i % 3) + 1}`}>
          <a href={post.slug} class="blog-card__img-link" tabindex="-1" aria-hidden="true">
            <img
              src={post.image || `https://picsum.photos/seed/blog-${i}/600/340`}
              alt=""
              width="600"
              height="340"
              loading="lazy"
              class="blog-card__img"
            />
          </a>
          <div class="blog-card__body">
            <div class="blog-card__meta">
              <span class="blog-card__cat">{post.category}</span>
              <time datetime={post.date} class="blog-card__date">
                {new Date(post.date).toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </div>
            <h2 class="blog-card__title">
              <a href={post.slug}>{post.title}</a>
            </h2>
            <p class="blog-card__desc">{post.desc}</p>
            <a href={post.slug} class="blog-card__link" aria-label={`Leer artículo: ${post.title}`}>
              Leer artículo
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section cta-blog" aria-labelledby="cta-blog-heading">
    <div class="container cta-blog__inner">
      <h2 id="cta-blog-heading" class="reveal">¿Quieres apoyar nuestra misión?</h2>
      <div class="cta-blog__actions reveal reveal-delay-1">
        <a href="/programas" class="btn btn-primary">Conoce nuestros programas</a>
        <a href="/donaciones" class="btn btn-outline">Apoya la fundación</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* ── Page header ─────────────────────────────────────────────────── */
.page-header {
  padding-block: clamp(3rem, 5vw, 4.5rem);
  background-color: var(--color-primary);
}

.page-header h1 {
  color: var(--color-white);
  margin-top: var(--space-5);
  font-size: clamp(3rem, 7vw, 6rem);
  font-weight: 700;
  line-height: 1.0;
  letter-spacing: -0.03em;
  text-wrap: balance;
}

.page-header h1::before {
  content: '';
  display: block;
  width: 44px;
  height: 3px;
  background-color: var(--color-accent);
  border-radius: 2px;
  margin-bottom: var(--space-5);
}

.page-header__desc {
  color: oklch(1 0 0 / 0.82);
  font-size: clamp(1rem, 1.5vw, 1.125rem);
  line-height: 1.65;
  margin-top: var(--space-4);
  max-width: 60ch;
}

/* ── Categorías (sobre fondo verde) ─────────────────────────────── */
.blog-cats { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
.blog-cat {
  background-color: oklch(1 0 0 / 0.12);
  color: var(--color-white);
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 0.8125rem;
  padding: 0.375rem 0.875rem;
  border-radius: var(--radius-full);
  border: 1px solid oklch(1 0 0 / 0.25);
}

/* ── Blog grid ────────────────────────────────────────────────────── */
.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--space-8);
}

.blog-card {
  background-color: var(--color-bg);
  border: 1px solid oklch(0.26 0.035 145 / 0.10);
  border-radius: var(--radius-md);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: border-color 250ms var(--ease-expo);
}
.blog-card:hover { border-color: oklch(0.67 0.065 155 / 0.30); }

.blog-card__img-link { display: block; overflow: hidden; }
.blog-card__img { width: 100%; height: 220px; object-fit: cover; transition: transform 400ms var(--ease-expo); }
.blog-card:hover .blog-card__img { transform: scale(1.03); }

.blog-card__body { padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-4); flex: 1; }

.blog-card__meta { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
.blog-card__cat {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 0.875rem;
  font-style: italic;
  color: var(--color-accent);
}
.blog-card__date { font-size: 0.8125rem; color: var(--color-ink-muted); max-width: none; }

.blog-card__title { font-size: 1.125rem; line-height: 1.3; }
.blog-card__title a { color: var(--color-ink); text-decoration: none; transition: color 200ms; }
.blog-card__title a:hover { color: var(--color-primary); }

.blog-card__desc { font-size: 0.9375rem; color: var(--color-ink-muted); line-height: 1.65; flex: 1; }

.blog-card__link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.875rem;
  color: var(--color-primary);
  transition: gap 200ms var(--ease-expo), color 200ms;
}
.blog-card__link:hover { gap: var(--space-3); color: var(--color-accent); }

/* ── CTA ──────────────────────────────────────────────────────────── */
.cta-blog { background-color: var(--color-ink); }

.cta-blog__inner { text-align: center; }

.cta-blog__inner h2 {
  color: var(--color-white);
  font-size: clamp(1.75rem, 3vw, 2.5rem);
}

.cta-blog__actions {
  display: flex;
  gap: var(--space-4);
  justify-content: center;
  flex-wrap: wrap;
  margin-top: var(--space-6);
}

.cta-blog__actions .btn-outline {
  border-color: oklch(1 0 0 / 0.4);
  color: oklch(1 0 0 / 0.85);
}
.cta-blog__actions .btn-outline:hover {
  background-color: var(--color-white);
  color: var(--color-ink);
}
</style>
