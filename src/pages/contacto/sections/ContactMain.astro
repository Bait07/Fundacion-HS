---
import { motivos } from '../data/index';
---
<section class="section" aria-labelledby="form-heading">
  <div class="container contacto-inner">
    <div class="contacto-form-wrap">
      <h2 id="form-heading">Envíanos un mensaje</h2>
      <form class="contacto-form" id="contactForm" novalidate aria-label="Formulario de contacto">
        <div class="form-group">
          <label for="nombre" class="form-label">Nombre completo <span aria-hidden="true">*</span></label>
          <input type="text" id="nombre" name="nombre" class="form-input" placeholder="Tu nombre completo" required autocomplete="name" aria-required="true" />
          <span class="form-error" id="nombre-error" role="alert" aria-live="polite"></span>
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Correo electrónico <span aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" class="form-input" placeholder="tu@correo.com" required autocomplete="email" aria-required="true" />
          <span class="form-error" id="email-error" role="alert" aria-live="polite"></span>
        </div>

        <div class="form-group">
          <label for="telefono" class="form-label">Teléfono / WhatsApp</label>
          <input type="tel" id="telefono" name="telefono" class="form-input" placeholder="+57 300 000 0000" autocomplete="tel" />
        </div>

        <div class="form-group">
          <label for="motivo" class="form-label">Motivo de contacto <span aria-hidden="true">*</span></label>
          <select id="motivo" name="motivo" class="form-input form-select" required aria-required="true">
            <option value="" disabled selected>Selecciona un motivo</option>
            {motivos.map(m => <option value={m}>{m}</option>)}
          </select>
          <span class="form-error" id="motivo-error" role="alert" aria-live="polite"></span>
        </div>

        <div class="form-group form-group--full">
          <label for="mensaje" class="form-label">Mensaje <span aria-hidden="true">*</span></label>
          <textarea id="mensaje" name="mensaje" class="form-input form-textarea" placeholder="Cuéntanos cómo podemos ayudarte..." rows="5" required aria-required="true"></textarea>
          <span class="form-error" id="mensaje-error" role="alert" aria-live="polite"></span>
        </div>

        <div id="form-status" class="form-status" role="status" aria-live="polite" aria-atomic="true"></div>

        <button type="submit" class="btn btn-accent form-submit" id="submitBtn">
          Enviar mensaje
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
        </button>
      </form>
    </div>

    <aside class="contacto-info" aria-label="Información de contacto">
      <h2>Información de contacto</h2>
      <div class="contacto-info__items">
        <div class="contacto-info__item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="contacto-info__icon" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <div>
            <p class="contacto-info__label">Dirección</p>
            <p class="contacto-info__value">Bogotá D.C., Colombia</p>
            <p class="contacto-info__placeholder">Dirección exacta por confirmar</p>
          </div>
        </div>

        <div class="contacto-info__item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="contacto-info__icon" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72c.127.96.36 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.34 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <div>
            <p class="contacto-info__label">Teléfono</p>
            <p class="contacto-info__placeholder">Por confirmar</p>
          </div>
        </div>

        <div class="contacto-info__item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="contacto-info__icon" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
          </svg>
          <div>
            <p class="contacto-info__label">Correo electrónico</p>
            <p class="contacto-info__placeholder">Por confirmar</p>
          </div>
        </div>
      </div>

      <div class="contacto-info__wa">
        <p class="contacto-info__wa-text">¿Prefieres escribirnos directamente?</p>
        <a
          href="https://wa.me/XXXXXXXXXX?text=Hola,%20me%20gustar%C3%ADa%20obtener%20informaci%C3%B3n%20sobre%20la%20Fundaci%C3%B3n%20Horizontes%20de%20Sabidur%C3%ADa."
          class="btn btn-primary contacto-info__wa-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={`${import.meta.env.BASE_URL}whatsapp.png`} alt="" width="18" height="18" aria-hidden="true" />
          Chatear por WhatsApp
        </a>
      </div>
    </aside>
  </div>
</section>
