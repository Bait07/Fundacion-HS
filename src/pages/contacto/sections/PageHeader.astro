---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
---
<section class="page-header" aria-labelledby="page-title">
  <div class="container">
    <Breadcrumbs crumbs={[{ label: 'Contacto' }]} inverted />
    <h1 id="page-title" class="reveal">Contáctanos</h1>
    <p class="page-header__desc reveal reveal-delay-1">
      Ya sea que busques información sobre nuestros programas, quieras apoyar la fundación o simplemente conocernos, estamos aquí.
    </p>
  </div>
</section>
