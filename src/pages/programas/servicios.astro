---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const seo = {
  title: 'Servicios Profesionales — Apoyo Integral para la Inclusión | FHS Bogotá',
  description: 'Psicología, fonoaudiología y terapia ocupacional especializada para personas con discapacidad cognitiva e intelectual en Bogotá.',
};

const servicios = [
  {
    titulo: 'Psicología',
    nombre: '"Espacios para Crecer y Sentir"',
    desc: 'Acompañamiento emocional, fortalecimiento de habilidades sociales, orientación familiar y apoyo conductual.',
    color: 'var(--color-primary)',
  },
  {
    titulo: 'Fonoaudiología',
    nombre: '"Comunico Mi Mundo"',
    desc: 'Estimulación del lenguaje, comunicación funcional y fortalecimiento comunicativo.',
    color: 'var(--color-accent)',
  },
  {
    titulo: 'Terapia Ocupacional',
    nombre: '"Moviendo Mis Habilidades"',
    desc: 'Fortalecimiento de motricidad, integración sensorial y habilidades para la vida diaria.',
    color: 'var(--color-primary)',
  },
];
---

<BaseLayout title={seo.title} description={seo.description}>
  <section class="prog-header bg-primary" aria-labelledby="prog-title">
    <div class="container">
      <Breadcrumbs crumbs={[{ label: 'Programas', href: '/programas' }, { label: 'Servicios Profesionales' }]} />
      <h1 id="prog-title" class="reveal">Apoyo Integral para la Inclusión</h1>
      <p class="prog-header__desc reveal reveal-delay-1">
        Atención interdisciplinaria orientada al fortalecimiento del desarrollo integral y la inclusión educativa y social de personas con discapacidad cognitiva.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="servicios-heading">
    <div class="container">
      <h2 id="servicios-heading" class="reveal" style="text-align:center;margin-bottom:var(--space-12)">Nuestros servicios</h2>
      <div class="servicios-grid">
        {servicios.map((s, i) => (
          <article class={`servicio-card anim-delay-${i + 1}`} data-anim="fadeInLeft" style={`--card-accent: ${s.color}`}>
            <div class="servicio-card__header">
              <p class="servicio-card__tipo">{s.titulo}</p>
              <h3 class="servicio-card__nombre">{s.nombre}</h3>
            </div>
            <p class="servicio-card__desc">{s.desc}</p>
            <a href="/contacto?motivo=informacion-programas" class="btn btn-outline servicio-card__cta">
              Solicitar información
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section equipo-section" aria-labelledby="equipo-heading">
    <div class="container" style="text-align:center">
      <h2 id="equipo-heading" class="reveal">Equipo interdisciplinario</h2>
      <p class="reveal reveal-delay-1" style="color:var(--color-ink-muted);margin-top:var(--space-3);margin-inline:auto;max-width:55ch">
        Nuestros profesionales trabajan de forma coordinada para garantizar una atención integral, personalizada y efectiva para cada persona y su familia.
      </p>
      <a href="/nosotros#equipo" class="btn btn-primary reveal reveal-delay-2" style="margin-top:var(--space-6);display:inline-flex">
        Conocer el equipo
      </a>
    </div>
  </section>
</BaseLayout>

<style>
/* ── Header ─────────────────────────────────────────────────────── */
.prog-header { padding-block: clamp(3rem, 6vw, 5rem); }

.prog-header h1 {
  color: var(--color-white);
  font-size: clamp(2rem, 4.5vw, 4rem);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  text-wrap: balance;
  margin-top: var(--space-5);
}

.prog-header h1::before {
  content: '';
  display: block;
  width: 44px;
  height: 3px;
  background-color: var(--color-accent);
  border-radius: 2px;
  margin-bottom: var(--space-5);
}

.prog-header__desc {
  color: oklch(1 0 0 / 0.82);
  font-size: clamp(1rem, 1.5vw, 1.125rem);
  line-height: 1.75;
  margin-top: var(--space-4);
  max-width: 60ch;
}

/* ── Servicios ───────────────────────────────────────────────────── */
.servicios-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-6);
}

.servicio-card {
  background-color: oklch(0.67 0.065 155 / 0.06);
  border: 1px solid oklch(0.26 0.035 145 / 0.10);
  border-radius: var(--radius-md);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  transition: background-color 250ms var(--ease-expo), border-color 250ms var(--ease-expo);
}

.servicio-card:hover {
  background-color: oklch(0.67 0.065 155 / 0.12);
  border-color: oklch(0.67 0.065 155 / 0.25);
}

.servicio-card__header { display: flex; flex-direction: column; gap: var(--space-2); }

.servicio-card__tipo {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.875rem;
  font-style: italic;
  color: var(--card-accent);
  max-width: none;
}

.servicio-card__nombre { font-size: 1.25rem; color: var(--color-ink); font-weight: 700; }
.servicio-card__desc { font-size: 0.9375rem; line-height: 1.65; color: var(--color-ink-muted); flex: 1; }
.servicio-card__cta { margin-top: auto; align-self: flex-start; }

/* ── Equipo ──────────────────────────────────────────────────────── */
.equipo-section { border-top: 1px solid oklch(0.26 0.035 145 / 0.10); }
</style>
