---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const seo = {
  title: 'Plan Padrino — Apadrina un Sueño, Transforma una Vida | FHS Bogotá',
  description: 'Sé padrino de un niño con discapacidad cognitiva en Bogotá y apoya su acceso a educación inclusiva. Conoce las modalidades de apadrinamiento de la Fundación Horizontes de Sabiduría.',
};

const modalidades = [
  {
    title: 'Padrino Total',
    desc: 'Cubre el valor completo de pensión o matrícula. Incluye material escolar y apoyo complementario.',
    icon: 'star',
    featured: true,
  },
  {
    title: 'Padrino Parcial',
    desc: 'Aporta un porcentaje del costo. Permite apoyos compartidos entre varios padrinos.',
    icon: 'half',
  },
  {
    title: 'Padrino Empresarial',
    desc: 'Empresas o entidades patrocinan uno o varios estudiantes. Incluye certificación de donación e informes de impacto.',
    icon: 'building',
  },
  {
    title: 'Fondo Solidario Educativo',
    desc: 'Aportes libres para emergencias educativas o subsidios complementarios.',
    icon: 'jar',
  },
];

const beneficiarios = [
  'Niños, niñas y adolescentes con discapacidad cognitiva e intelectual',
  'Familias de bajos recursos económicos',
  'En riesgo de deserción escolar',
  'Vinculados o en proceso de ingreso a instituciones inclusivas',
];
---

<BaseLayout title={seo.title} description={seo.description}>
  <!-- Page Header -->
  <section class="padrino-header" aria-labelledby="page-title">
    <div class="container">
      <Breadcrumbs crumbs={[
        { label: 'Programas', href: '/programas' },
        { label: 'Plan Padrino' }
      ]} />
      <div class="padrino-header__inner">
        <div class="padrino-header__copy">
          <h1 id="page-title" class="reveal">
            Apadrina un sueño,<br/>transforma una vida.
          </h1>
          <p class="padrino-header__desc reveal reveal-delay-1">
            El Plan Padrino es una estrategia solidaria de la FHS para brindar apoyo económico a niños, niñas y adolescentes con discapacidad cognitiva e intelectual de familias de bajos recursos, facilitando su acceso, permanencia y continuidad en instituciones educativas inclusivas.
          </p>
          <a href="/contacto?motivo=plan-padrino" class="btn btn-accent reveal reveal-delay-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            Quiero apadrinar un sueño
          </a>
        </div>
        <div class="padrino-header__visual reveal">
          <img
            src="https://picsum.photos/seed/sponsor-child-school-colombia/550/600"
            alt="Niño con discapacidad cognitiva sonriendo en el aula, apoyado por el Plan Padrino de la Fundación Horizontes de Sabiduría"
            width="550"
            height="600"
            loading="eager"
            fetchpriority="high"
            class="padrino-header__img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Por qué -->
  <section class="section justif-section" aria-labelledby="justification-heading">
    <div class="container justif-inner">
      <div class="justif-text">
        <h2 id="justification-heading" class="reveal">Por qué existe el Plan Padrino</h2>
        <p class="reveal reveal-delay-1">
          En Colombia, muchas familias enfrentan barreras económicas que impiden que sus hijos con discapacidad accedan a educación inclusiva especializada. Los costos de matrículas, terapias, materiales y transporte pueden ser insalvables.
        </p>
        <p class="reveal reveal-delay-2">
          La FHS crea el Plan Padrino como una alternativa solidaria para que ningún niño pierda su oportunidad de aprender.
        </p>
      </div>
      <div class="beneficiarios reveal reveal-delay-3">
        <h3>Población beneficiaria</h3>
        <ul class="beneficiarios__list" role="list">
          {beneficiarios.map(b => (
            <li class="beneficiarios__item">
              <span class="beneficiarios__dot" aria-hidden="true"></span>
              {b}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Modalidades -->
  <section class="section" aria-labelledby="modalidades-heading">
    <div class="container">
      <div class="modalidades-header reveal">
        <h2 id="modalidades-heading">Modalidades de apadrinamiento</h2>
        <p>Elige la forma de apoyo que mejor se adapte a tus posibilidades.</p>
      </div>
      <div class="modalidades-grid">
        {modalidades.map((m, i) => (
          <div class={`modalidad-card ${m.featured ? 'modalidad-card--featured' : ''} anim-delay-${i + 1}`} data-anim="fadeInLeft">
            {m.featured && <div class="modalidad-card__badge">Más popular</div>}
            <h3 class="modalidad-card__title">{m.title}</h3>
            <p class="modalidad-card__desc">{m.desc}</p>
            <a
              href="/contacto?motivo=plan-padrino"
              class={`btn ${m.featured ? 'btn-accent' : 'btn-outline'}`}
            >
              Elegir esta modalidad
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="section padrino-final bg-ink" aria-labelledby="final-cta-heading">
    <div class="container padrino-final__inner">
      <h2 id="final-cta-heading" class="reveal">Un gesto tuyo cambia una historia.</h2>
      <p class="reveal reveal-delay-1">
        No se necesita un gran aporte. Se necesita la decisión de hacer la diferencia.
      </p>
      <div class="padrino-final__actions reveal reveal-delay-2">
        <a href="/contacto?motivo=plan-padrino" class="btn btn-accent">Quiero ser padrino</a>
        <a href="/donaciones" class="btn btn-ghost">Hacer una donación</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* ── Header ─────────────────────────────────────────────────────── */
.padrino-header {
  background-color: var(--color-primary);
  padding-block: clamp(3rem, 6vw, 6rem);
}

.padrino-header__inner {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: clamp(3rem, 6vw, 6rem);
  align-items: center;
  margin-top: var(--space-6);
}

.padrino-header__copy {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.padrino-header__copy .btn { align-self: flex-start; }

.padrino-header__copy h1 {
  font-size: clamp(2.25rem, 4vw, 3.75rem);
  color: var(--color-white);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  text-wrap: balance;
}

.padrino-header__copy h1::before {
  content: '';
  display: block;
  width: 44px;
  height: 3px;
  background-color: var(--color-accent);
  border-radius: 2px;
  margin-bottom: var(--space-5);
}

.padrino-header__desc {
  font-size: 1.0625rem;
  line-height: 1.75;
  color: oklch(1 0 0 / 0.82);
  max-width: 55ch;
}

.padrino-header__visual {
  overflow: hidden;
  border-radius: var(--radius-lg);
  box-shadow: 0 16px 48px oklch(0.26 0.035 145 / 0.25);
  transition: box-shadow 400ms var(--ease-expo);
}
.padrino-header__visual:hover { box-shadow: 0 24px 56px oklch(0.26 0.035 145 / 0.35); }

.padrino-header__img {
  width: 100%;
  height: 500px;
  object-fit: cover;
  transition: transform 600ms var(--ease-expo);
}
.padrino-header__visual:hover .padrino-header__img { transform: scale(1.06); }

/* ── Justificación ───────────────────────────────────────────────── */
.justif-section { border-top: 1px solid oklch(0.26 0.035 145 / 0.10); }

.justif-inner {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: clamp(3rem, 5vw, 5rem);
  align-items: start;
}

.justif-text {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.justif-text h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
.justif-text p { font-size: 1.0625rem; line-height: 1.75; color: var(--color-ink); }

.beneficiarios {
  background-color: oklch(0.67 0.065 155 / 0.07);
  border: 1px solid oklch(0.67 0.065 155 / 0.18);
  border-radius: var(--radius-md);
  padding: var(--space-8);
}

.beneficiarios h3 {
  font-size: 1.125rem;
  margin-bottom: var(--space-5);
  color: var(--color-ink);
}

.beneficiarios__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.beneficiarios__item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  font-size: 0.9375rem;
  color: var(--color-ink);
  line-height: 1.5;
}

.beneficiarios__dot {
  width: 8px;
  height: 8px;
  border-radius: var(--radius-full);
  background-color: var(--color-accent);
  flex-shrink: 0;
  margin-top: 6px;
}

/* ── Modalidades ─────────────────────────────────────────────────── */
.modalidades-header { text-align: center; margin-bottom: var(--space-12); }
.modalidades-header p { color: var(--color-ink-muted); margin-top: var(--space-3); margin-inline: auto; }

.modalidades-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: var(--space-6);
}

.modalidad-card {
  background-color: oklch(0.67 0.065 155 / 0.06);
  border: 1px solid oklch(0.26 0.035 145 / 0.10);
  border-radius: var(--radius-md);
  padding: var(--space-8) var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  position: relative;
  transition: background-color 250ms var(--ease-expo), border-color 250ms var(--ease-expo);
}

.modalidad-card:hover {
  background-color: oklch(0.67 0.065 155 / 0.12);
  border-color: oklch(0.67 0.065 155 / 0.25);
}

.modalidad-card--featured {
  background-color: oklch(0.41 0.138 143 / 0.06);
  border-color: oklch(0.41 0.138 143 / 0.30);
}
.modalidad-card--featured:hover {
  background-color: oklch(0.41 0.138 143 / 0.10);
  border-color: var(--color-accent);
}

.modalidad-card__badge {
  position: absolute;
  top: -12px;
  left: 50%;
  transform: translateX(-50%);
  background-color: var(--color-accent);
  color: var(--color-white);
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.75rem;
  padding: 0.25rem 0.875rem;
  border-radius: var(--radius-full);
  white-space: nowrap;
}

.modalidad-card__title { font-size: 1.125rem; color: var(--color-ink); font-weight: 700; }
.modalidad-card__desc { font-size: 0.9375rem; line-height: 1.65; color: var(--color-ink-muted); flex: 1; }

/* ── CTA final ───────────────────────────────────────────────────── */
.padrino-final__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-6);
}

.padrino-final__inner h2 {
  color: var(--color-white);
  font-size: clamp(2rem, 3.5vw, 3rem);
}

.padrino-final__inner p {
  color: oklch(1 0 0 / 0.75);
  font-size: 1.125rem;
  max-width: 45ch;
  text-align: center;
  margin-inline: auto;
}

.padrino-final__actions {
  display: flex;
  gap: var(--space-4);
  flex-wrap: wrap;
  justify-content: center;
}

/* ── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 1023px) {
  .padrino-header__inner { grid-template-columns: 1fr; }
  .padrino-header__img { height: 340px; }
  .justif-inner { grid-template-columns: 1fr; }
}
</style>
