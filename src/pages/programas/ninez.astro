---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const seo = {
  title: 'Programa Niñez — Inclusión Escolar para Niños con Discapacidad Cognitiva en Bogotá',
  description: 'Acompañamos a niños y niñas con discapacidad cognitiva en Bogotá en su proceso de inclusión escolar con talleres especializados en habilidades cognitivas, autonomía y socialización.',
};

const talleres = [
  { nombre: '"Aprendo y Sigo Indicaciones"', desc: 'Fortalece el seguimiento de instrucciones, atención y adaptación a rutinas.' },
  { nombre: '"Mi Ruta Escolar"', desc: 'Promueve hábitos escolares, organización y adaptación al aula.' },
  { nombre: '"Explorando con Atención"', desc: 'Estimula la concentración, memoria y permanencia en actividades.' },
  { nombre: '"Manitos Creativas"', desc: 'Desarrolla motricidad fina y habilidades previas a la escritura.' },
  { nombre: '"Descubriendo Letras y Sonidos"', desc: 'Inicia procesos de lectoescritura y reconocimiento fonológico.' },
  { nombre: '"Hablo, Expreso y Comunico"', desc: 'Fortalece lenguaje, expresión verbal y comunicación funcional.' },
  { nombre: '"Amigos y Emociones"', desc: 'Favorece habilidades sociales, convivencia y expresión emocional.' },
  { nombre: '"Yo Puedo Solo"', desc: 'Promueve autonomía en hábitos de higiene, alimentación y organización personal.' },
];

const areas = [
  'Adaptación al entorno escolar',
  'Habilidades cognitivas y comunicativas',
  'Autonomía básica',
  'Socialización y manejo emocional',
  'Acompañamiento terapéutico',
];
---

<BaseLayout title={seo.title} description={seo.description}>
  <section class="prog-header bg-primary" aria-labelledby="prog-title">
    <div class="container">
      <Breadcrumbs crumbs={[
        { label: 'Programas', href: '/programas' },
        { label: 'Niñez' }
      ]} />
      <div class="prog-header__inner">
        <div>
          <p class="prog-header__eyebrow">Programa de Niñez</p>
          <h1 id="prog-title" class="reveal">Primeros Pasos hacia la Inclusión Escolar</h1>
          <p class="prog-header__desc reveal reveal-delay-1">
            Fortalecer en niños y niñas las habilidades básicas necesarias para favorecer su acercamiento, adaptación e inclusión en el entorno escolar y social.
          </p>
          <div class="prog-header__actions reveal reveal-delay-2">
            <a href="/contacto?motivo=informacion-programas" class="btn btn-accent">Solicitar información</a>
            <a href="/programas" class="btn btn-outline">Ver todos los programas</a>
          </div>
        </div>
        <div class="prog-header__img-wrap reveal">
          <img
            src="https://picsum.photos/seed/children-learning-classroom/480/380"
            alt="Niños con discapacidad cognitiva participando en actividades de inclusión escolar en la Fundación Horizontes de Sabiduría"
            width="480"
            height="380"
            loading="eager"
            class="prog-header__img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Áreas de trabajo -->
  <section class="section" aria-labelledby="areas-heading">
    <div class="container areas-inner">
      <h2 id="areas-heading" class="reveal">¿Qué trabajamos?</h2>
      <ul class="areas-list reveal reveal-delay-1" role="list">
        {areas.map(area => (
          <li class="areas-item">
            <span class="areas-check" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            {area}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Talleres -->
  <section class="section talleres-section" aria-labelledby="talleres-heading">
    <div class="container">
      <div class="talleres-header reveal">
        <h2 id="talleres-heading">Nuestros talleres</h2>
        <p>Actividades diseñadas por un equipo interdisciplinario para el desarrollo integral de cada niño.</p>
      </div>
      <div class="talleres-grid">
        {talleres.map((t, i) => (
          <article class={`taller-card anim-delay-${(i % 4) + 1}`} data-anim="fadeInLeft">
            <h3 class="taller-card__title">{t.nombre}</h3>
            <p class="taller-card__desc">{t.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-prog" aria-labelledby="cta-prog-heading">
    <div class="container cta-prog__inner">
      <h2 id="cta-prog-heading" class="reveal">¿Tu hijo puede participar?</h2>
      <p class="reveal reveal-delay-1">
        Contáctanos para conocer los requisitos de ingreso, horarios y disponibilidad de cupos.
      </p>
      <div class="reveal reveal-delay-2">
        <a href="/contacto?motivo=informacion-programas" class="btn btn-primary">Consultar disponibilidad</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* ── Header ─────────────────────────────────────────────────────── */
.prog-header { padding-block: clamp(3rem, 6vw, 5rem); }

.prog-header__eyebrow {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 0.875rem;
  font-style: italic;
  color: oklch(1 0 0 / 0.65);
  margin-bottom: var(--space-3);
  max-width: none;
}

.prog-header__inner {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: clamp(3rem, 5vw, 5rem);
  align-items: center;
  margin-top: var(--space-4);
}

.prog-header h1 {
  color: var(--color-white);
  font-size: clamp(2rem, 4.5vw, 4rem);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  text-wrap: balance;
}

.prog-header h1::before {
  content: '';
  display: block;
  width: 44px;
  height: 3px;
  background-color: var(--color-accent);
  border-radius: 2px;
  margin-bottom: var(--space-5);
}

.prog-header__desc {
  color: oklch(1 0 0 / 0.82);
  font-size: clamp(1rem, 1.5vw, 1.0625rem);
  line-height: 1.75;
  margin-top: var(--space-4);
  max-width: 55ch;
}

.prog-header__actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-6); }

.prog-header__actions .btn-outline {
  border-color: oklch(1 0 0 / 0.4);
  color: oklch(1 0 0 / 0.85);
}
.prog-header__actions .btn-outline:hover {
  background-color: var(--color-white);
  color: var(--color-ink);
}

.prog-header__img-wrap {
  overflow: hidden;
  border-radius: var(--radius-lg);
  box-shadow: 0 8px 32px oklch(0.26 0.035 145 / 0.12);
  transition: box-shadow 400ms var(--ease-expo);
}
.prog-header__img-wrap:hover { box-shadow: 0 16px 48px oklch(0.26 0.035 145 / 0.18); }

.prog-header__img {
  width: 100%;
  height: 320px;
  object-fit: cover;
  transition: transform 600ms var(--ease-expo);
}
.prog-header__img-wrap:hover .prog-header__img { transform: scale(1.06); }

/* ── Áreas ───────────────────────────────────────────────────────── */
.areas-inner { display: flex; flex-direction: column; gap: var(--space-8); }
.areas-list { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); }
.areas-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  font-size: 1.0625rem;
  color: var(--color-ink);
  padding: var(--space-4) var(--space-5);
  background-color: oklch(0.67 0.065 155 / 0.07);
  border-radius: var(--radius-sm);
  transition: background-color 200ms, transform 200ms var(--ease-expo);
}
.areas-item:hover { background-color: oklch(0.67 0.065 155 / 0.14); transform: translateX(4px); }
.areas-check { color: var(--color-primary); flex-shrink: 0; }

/* ── Talleres ────────────────────────────────────────────────────── */
.talleres-section { border-top: 1px solid oklch(0.26 0.035 145 / 0.10); }
.talleres-header { text-align: center; margin-bottom: var(--space-10); }
.talleres-header p { color: var(--color-ink-muted); margin-top: var(--space-3); margin-inline: auto; }

.talleres-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid oklch(0.26 0.035 145 / 0.12);
  border-left: 1px solid oklch(0.26 0.035 145 / 0.12);
  counter-reset: taller-num;
}

.taller-card {
  padding: var(--space-6) var(--space-5);
  border-bottom: 1px solid oklch(0.26 0.035 145 / 0.12);
  border-right: 1px solid oklch(0.26 0.035 145 / 0.12);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  counter-increment: taller-num;
  transition: background-color 200ms;
}
.taller-card::before {
  content: counter(taller-num, decimal-leading-zero);
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.75rem;
  color: var(--color-primary);
  display: block;
}
.taller-card:hover { background-color: oklch(0.67 0.065 155 / 0.05); }

.taller-card__title {
  font-size: 0.9375rem;
  color: var(--color-ink);
  font-style: italic;
  font-weight: 600;
}
.taller-card__desc { font-size: 0.875rem; color: var(--color-ink-muted); line-height: 1.6; }

/* ── CTA ─────────────────────────────────────────────────────────── */
.cta-prog { text-align: center; background-color: var(--color-ink); }
.cta-prog__inner { display: flex; flex-direction: column; align-items: center; gap: var(--space-5); }
.cta-prog__inner h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); color: var(--color-white); }
.cta-prog__inner p { color: oklch(1 0 0 / 0.72); font-size: 1.0625rem; max-width: 50ch; text-align: center; margin-inline: auto; }

/* ── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 1023px) {
  .prog-header__inner { grid-template-columns: 1fr; }
  .prog-header__img { height: 260px; }
  .talleres-grid { grid-template-columns: 1fr; }
}
</style>
