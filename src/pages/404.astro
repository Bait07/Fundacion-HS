---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seo = {
  title: 'Página no encontrada',
  description: 'La página que buscas no existe o fue movida. Vuelve al inicio o explora nuestros programas de inclusión.',
};
---

<BaseLayout title={seo.title} description={seo.description}>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="container not-found__inner">
      <dotlottie-wc
        id="notFoundLottie"
        src={`${import.meta.env.BASE_URL}lottie/404.lottie`}
        autoplay
        loop
        class="not-found__lottie"
        aria-hidden="true"
      ></dotlottie-wc>

      <p class="not-found__eyebrow">Error 404</p>
      <h1 id="not-found-title">Esta página se perdió el camino</h1>
      <p class="not-found__desc">
        El enlace que seguiste no existe o cambió de lugar. Volvamos a un sitio conocido.
      </p>
      <div class="not-found__actions">
        <a href={import.meta.env.BASE_URL} class="btn btn-primary">Volver al inicio</a>
        <a href={`${import.meta.env.BASE_URL}programas`} class="btn btn-outline">Ver nuestros programas</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import './_js/404';
</script>

<script type="module" src="https://cdn.jsdelivr.net/npm/@lottiefiles/dotlottie-wc@0.9.27/dist/dotlottie-wc.js"></script>

<style>
.not-found {
  min-height: calc(100vh - var(--nav-height));
  display: flex;
  align-items: center;
  padding-block: clamp(2rem, 6vw, 4rem);
}

.not-found__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-2);
}

.not-found__lottie {
  width: min(640px, 90vw);
  height: min(640px, 90vw);
  margin-bottom: var(--space-4);
}

.not-found__eyebrow {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.875rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-primary);
  max-width: none;
}

.not-found h1 {
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  max-width: 20ch;
}

.not-found__desc {
  color: var(--color-ink-muted);
  font-size: 1.0625rem;
  max-width: 46ch;
  margin-top: var(--space-3);
}

.not-found__actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  justify-content: center;
  margin-top: var(--space-8);
}
</style>
