---
// WhatsApp FAB — always visible, bottom right
// Number placeholder — la FHS debe proveer el número
const whatsappNumber = '573173759920';
const whatsappMessage = encodeURIComponent('Hola, me gustaría conocer más sobre los programas de la Fundación Horizontes de Sabiduría.');
const whatsappURL = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<a
  href={whatsappURL}
  class="whatsapp-fab"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  title="¡Escríbenos!"
>
  <img src={`${import.meta.env.BASE_URL}whatsapp.png`} alt="" width="56" height="56" class="whatsapp-fab__icon" aria-hidden="true" />
  <span class="whatsapp-fab__tooltip" aria-hidden="true">¡Escríbenos!</span>
</a>

<style>
.whatsapp-fab {
  position: fixed;
  bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
  right: 1.5rem;
  z-index: var(--z-fab);
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  width: 56px;
  height: 56px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4);
  transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
  animation: fab-pulse 2s ease-in-out 1s 3;
}

.whatsapp-fab__icon {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: var(--radius-full);
}

.whatsapp-fab:hover {
  transform: scale(1.08);
  box-shadow: 0 6px 28px rgba(37, 211, 102, 0.5);
  color: white;
}

.whatsapp-fab:active {
  transform: scale(0.96);
}

.whatsapp-fab__tooltip {
  position: absolute;
  right: calc(100% + 10px);
  top: 50%;
  transform: translateY(-50%);
  background-color: var(--color-ink);
  color: white;
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 500;
  padding: 0.375rem 0.75rem;
  border-radius: var(--radius-sm);
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 200ms var(--ease-out);
}

.whatsapp-fab__tooltip::after {
  content: '';
  position: absolute;
  left: 100%;
  top: 50%;
  transform: translateY(-50%);
  border: 5px solid transparent;
  border-left-color: var(--color-ink);
}

.whatsapp-fab:hover .whatsapp-fab__tooltip {
  opacity: 1;
}

@keyframes fab-pulse {
  0%, 100% { box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4); }
  50% { box-shadow: 0 4px 32px rgba(37, 211, 102, 0.65); transform: scale(1.05); }
}

@media (prefers-reduced-motion: reduce) {
  .whatsapp-fab {
    animation: none;
  }
}

@media (max-width: 639px) {
  .whatsapp-fab {
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    right: 1rem;
    width: 52px;
    height: 52px;
  }

  .whatsapp-fab__tooltip {
    display: none;
  }
}
</style>
